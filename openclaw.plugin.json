{
  "$schema": "https://openclaw.ai/schemas/plugin.schema.json",
  "id": "@njuboy11/ark-kb",
  "name": "ark-kb",
  "version": "0.1.0",
  "description": "🏛️ Ark Knowledge Base — Personal knowledge base powered by LanceDB + Multimodal Embedding",
  "author": "njuboy11",
  "license": "MIT",
  "entry": "./index.js",
  "contracts": {
    "tools": true
  },
  "tools": [
    "kb_search",
    "kb_ingest",
    "kb_remove",
    "kb_status"
  ],
  "config": {
    "properties": {
      "knowledgePath": {
        "type": "string",
        "description": "Knowledge base folder path",
        "default": ""
      },
      "embeddingModel": {
        "type": "string",
        "description": "Embedding model name",
        "default": "Qwen3-VL-Embedding-8B"
      },
      "vectorDim": {
        "type": "number",
        "description": "Vector dimension",
        "default": 4096
      },
      "enableWatcher": {
        "type": "boolean",
        "description": "Enable file watcher for auto indexing",
        "default": true
      },
      "rerankerEnabled": {
        "type": "boolean",
        "description": "Enable reranker for precision sorting",
        "default": false
      },
      "searchTopK": {
        "type": "number",
        "description": "Initial recall count",
        "default": 20
      },
      "rerankerMinScore": {
        "type": "number",
        "description": "Reranker minimum score threshold",
        "default": 0.35
      },
      "resultCount": {
        "type": "number",
        "description": "Final result count",
        "default": 6
      }
    }
  }
}
