{
  "$schema": "https://openclaw.ai/schemas/plugin.schema.json",
  "id": "@njuboy11/ark-kb",
  "name": "ark-kb",
  "version": "0.2.0",
  "description": "🏛️ Ark Knowledge Base — Personal knowledge base powered by LanceDB + Multimodal Embedding",
  "author": "njuboy11",
  "license": "GPL-3.0-only",
  "entry": "./index.js",
  "contracts": {
    "tools": [
      "kb_search",
      "kb_ingest",
      "kb_remove",
      "kb_status"
    ]
  },
  "lifecycle": {
    "activate": {},
    "shutdown": {}
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "storage": {
        "type": "object",
        "description": "Storage configuration",
        "default": {},
        "properties": {
          "dbPath": {
            "type": "string",
            "description": "Path to LanceDB database directory",
            "default": "~/.ark-kb/lancedb"
          }
        }
      },
      "chunking": {
        "type": "object",
        "description": "Text chunking configuration",
        "default": {},
        "properties": {
          "maxTokens": {
            "type": "number",
            "description": "Max tokens per chunk (approximate char count for CJK)",
            "default": 400
          },
          "overlapTokens": {
            "type": "number",
            "description": "Overlap between adjacent chunks in tokens",
            "default": 50
          },
          "strategy": {
            "type": "string",
            "description": "Chunking strategy: paragraph | fixed | sentence",
            "default": "paragraph"
          }
        }
      },
      "embedding": {
        "type": "object",
        "description": "Embedding API configuration",
        "default": {},
        "properties": {
          "api": {
            "type": "string",
            "description": "Embedding API provider: dashscope | siliconflow | openai | custom",
            "default": "siliconflow"
          },
          "endpoint": {
            "type": "string",
            "description": "Embedding API endpoint URL",
            "default": "https://api.siliconflow.cn/v1/embeddings"
          },
          "apiKey": {
            "type": "string",
            "description": "API key for the embedding service"
          },
          "model": {
            "type": "string",
            "description": "Embedding model name",
            "default": "Qwen3-VL-Embedding-8B"
          },
          "dimensions": {
            "type": "number",
            "description": "Embedding vector dimensions",
            "default": 4096
          },
          "batchSize": {
            "type": "number",
            "description": "Max texts per embedding batch request",
            "default": 16
          }
        }
      },
      "pdfParser": {
        "type": "object",
        "description": "PDF parsing configuration",
        "default": {},
        "properties": {
          "api": {
            "type": "string",
            "description": "PDF parser: mineru | builtin | none",
            "default": "builtin"
          },
          "endpoint": {
            "type": "string",
            "description": "MinerU API endpoint URL"
          },
          "apiKey": {
            "type": "string",
            "description": "MinerU API key"
          },
          "model": {
            "type": "string",
            "description": "MinerU parsing model",
            "default": "doclayout_onnx"
          }
        }
      },
      "reranker": {
        "type": "object",
        "description": "Reranker configuration for precision scoring",
        "default": {},
        "properties": {
          "api": {
            "type": "string",
            "description": "Reranker API: siliconflow | cohere | custom | none",
            "default": "siliconflow"
          },
          "endpoint": {
            "type": "string",
            "description": "Reranker API endpoint URL"
          },
          "apiKey": {
            "type": "string",
            "description": "Reranker API key"
          },
          "model": {
            "type": "string",
            "description": "Reranker model name",
            "default": "BAAI/bge-m3"
          },
          "minScore": {
            "type": "number",
            "description": "Minimum relevance score to include in results",
            "default": 0.35
          }
        }
      },
      "search": {
        "type": "object",
        "description": "Search behavior configuration",
        "default": {},
        "properties": {
          "vectorWeight": {
            "type": "number",
            "description": "Weight for vector search score (0.0-1.0). BM25 weight = 1 - vectorWeight",
            "default": 0.7
          },
          "topK": {
            "type": "number",
            "description": "Initial recall count per search arm (vector + BM25)",
            "default": 20
          },
          "resultCount": {
            "type": "number",
            "description": "Final number of results to return",
            "default": 6
          }
        }
      },
      "watcher": {
        "type": "object",
        "description": "File watcher configuration",
        "default": {},
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Enable automatic file watching and indexing",
            "default": true
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional directories to watch (knowledgePath is always watched)"
          },
          "debounceMs": {
            "type": "number",
            "description": "Milliseconds to wait for file stability before re-indexing",
            "default": 2000
          },
          "ignorePatterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Glob patterns to ignore (e.g. *.tmp, .*, ~*)",
            "default": [
              "*.tmp",
              "*.swp",
              "~*",
              ".*"
            ]
          }
        }
      },
      "knowledgePath": {
        "type": "string",
        "description": "Root directory for the knowledge base files (defaults to ARK_KB_KNOWLEDGE_PATH env var, or ~/knowledge)"
      }
    }
  }
}
