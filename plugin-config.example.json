{
  "knowledgePath": "/root/.openclaw/workspace/knowledge",
  "storage": {
    "dbPath": "~/.ark-kb/lancedb-v2"
  },
  "embedding": {
    "model": "Qwen/Qwen3-VL-Embedding-8B",
    "apiKey": "YOUR_API_KEY_HERE",
    "endpoint": "https://api.siliconflow.cn/v1/embeddings",
    "dimensions": 4096
  },
  "reranker": {
    "model": "Qwen/Qwen3-Reranker-8B",
    "apiKey": "YOUR_API_KEY_HERE",
    "minScore": 0.35,
    "multimodal": {
      "model": "Qwen/Qwen3-VL-Reranker-8B",
      "apiKey": "YOUR_API_KEY_HERE"
    },
    "enabled": true
  },
  "search": {
    "vectorWeight": 1.0,
    "topK": 20,
    "resultCount": 6
  },
  "chunking": {
    "maxTokens": 400,
    "overlapTokens": 50,
    "strategy": "paragraph"
  },
  "pdfParser": {
    "endpoint": "https://mineru.net/api/v4/extract/task",
    "apiKey": "YOUR_API_KEY_HERE",
    "model": "doclayout_onnx",
    "params": {
      "enable_formula": true,
      "enable_table": true
    }
  },
  "watcher": {
    "enabled": true,
    "paths": [],
    "debounceMs": 2000,
    "ignorePatterns": [
      ".*",
      "~*",
      "*.tmp",
      "*.swp",
      "*.part"
    ]
  },
  "videoSummarizer": {
    "enabled": true,
    "endpoint": "https://api.minimaxi.com/v1/coding_plan/vlm",
    "apiKey": "YOUR_API_KEY_HERE",
    "maxFrames": 100
  },
  "embeddingMode": "text",
  "image": {
    "rerankerMode": "text"
  },
  "video": {
    "rerankerMode": "text"
  },
  "imageSummarizer": {
    "enabled": true,
    "endpoint": "https://api.minimaxi.com/v1/coding_plan/vlm",
    "apiKey": "YOUR_API_KEY_HERE"
  },
  "emailIngester": {
    "enabled": false,
    "host": "imap.example.com",
    "port": 993,
    "tls": true,
    "user": "your-email@example.com",
    "password": "your-password",
    "scanIntervalMs": 300000,
    "maxRetries": 2
  },
  "compact": {
    "_comment": "Auto-compact all KBs: calls LanceDB table.optimize() with compact+prune+index",
    "retentionDays": 1,
    "intervalDays": 1
  }
}